# Copy this file to .env.self-host and replace all placeholders.
# Use hex passwords for the local database, or URL-encode special characters in URLs.
POSTGRES_USER=monqom
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=monqom
DATABASE_URL=postgresql://monqom:replace-with-random-hex@postgres:5432/monqom
# Optionally use a separate schema-owner account for migrations:
# MIGRATION_DATABASE_URL=postgresql://migration-user:password@postgres:5432/monqom
SESSION_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-different-32-character-key
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-another-32-character-key
FRONTEND_URL=https://monqom.example.com
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Monqom <noreply@example.com>
TURNSTILE_ENABLED=false
# If enabling Turnstile, set both values and rebuild the frontend.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=
# FRONTEND_PORT=8080
